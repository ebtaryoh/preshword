<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>PRESHWORD — Thoughtfully Chosen Essentials for the Heart of Your Home</title>
  <meta name="description"
    content="Premium kitchenware, cookware, appliances, tableware, and children's dining products. Curated essentials delivered to your door.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --ivory: #FAF8F3;
      --forest: #234638;
      --sage: #DCE5DA;
      --charcoal: #242824;
      --terracotta: #C7795A;
      --white: #FFFFFF;
      --warm-gray: #E8E4DE;
      --warm-gray-dark: #B8B4AE;
      --gradient-hero: linear-gradient(135deg, #234638 0%, #2d5a4a 30%, #C7795A 100%);
      --gradient-accent: linear-gradient(135deg, #C7795A 0%, #e8956f 100%);
      --gradient-card: linear-gradient(135deg, #FAF8F3 0%, #f5f0ea 100%);
      --shadow-sm: 0 1px 3px rgba(36, 40, 36, 0.08);
      --shadow-md: 0 4px 12px rgba(36, 40, 36, 0.1);
      --shadow-lg: 0 8px 30px rgba(36, 40, 36, 0.12);
      --shadow-xl: 0 16px 48px rgba(36, 40, 36, 0.15);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-xl: 24px;
      --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      --font-serif: 'Playfair Display', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      font-family: var(--font-sans);
      background: var(--ivory);
      color: var(--charcoal);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
      font-family: inherit;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    input,
    select,
    textarea {
      font-family: inherit;
      font-size: inherit;
    }

    /* Focus styles */
    *:focus-visible {
      outline: 3px solid var(--terracotta);
      outline-offset: 2px;
    }

    /* Skip link */
    .skip-link {
      position: absolute;
      top: -100%;
      left: 50%;
      transform: translateX(-50%);
      background: var(--forest);
      color: white;
      padding: 12px 24px;
      border-radius: 0 0 var(--radius-sm) var(--radius-sm);
      z-index: 10000;
      font-weight: 600;
    }

    .skip-link:focus {
      top: 0;
    }

    /* ===== ANNOUNCEMENT BAR ===== */
    .announcement-bar {
      background: var(--forest);
      color: var(--ivory);
      text-align: center;
      padding: 8px 16px;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    .announcement-bar a {
      color: var(--terracotta);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* ===== HEADER ===== */
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(250, 248, 243, 0.95);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--warm-gray);
      transition: var(--transition);
    }

    .header.scrolled {
      box-shadow: var(--shadow-sm);
    }

    .header-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      gap: 16px;
    }

    .header.shrunk .header-inner {
      height: 56px;
    }

    .logo {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--forest);
      letter-spacing: -0.02em;
      flex-shrink: 0;
    }

    .logo span {
      color: var(--terracotta);
    }

    .nav-desktop {
      display: none;
      gap: 24px;
      align-items: center;
    }

    .nav-desktop a {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--charcoal);
      transition: var(--transition);
      position: relative;
      white-space: nowrap;
    }

    .nav-desktop a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--terracotta);
      transition: var(--transition);
    }

    .nav-desktop a:hover::after,
    .nav-desktop a.active::after {
      width: 100%;
    }

    .nav-desktop a:hover {
      color: var(--forest);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .header-btn {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: var(--transition);
      position: relative;
      color: var(--charcoal);
    }

    .header-btn:hover {
      background: var(--sage);
    }

    .header-btn svg {
      width: 22px;
      height: 22px;
    }

    .cart-count {
      position: absolute;
      top: 2px;
      right: 2px;
      background: var(--terracotta);
      color: white;
      font-size: 0.65rem;
      font-weight: 700;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transform: scale(0);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .cart-count.visible {
      transform: scale(1);
    }

    .mobile-menu-btn {
      display: flex;
      flex-direction: column;
      gap: 5px;
      width: 40px;
      height: 40px;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: var(--transition);
    }

    .mobile-menu-btn:hover {
      background: var(--sage);
    }

    .mobile-menu-btn span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--charcoal);
      border-radius: 2px;
      transition: var(--transition);
    }

    .mobile-menu-btn.open span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .mobile-menu-btn.open span:nth-child(2) {
      opacity: 0;
    }

    .mobile-menu-btn.open span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    /* ===== MOBILE MENU ===== */
    .mobile-menu {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      background: var(--ivory);
      z-index: 9999;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      padding: 80px 24px 120px;
    }

    .mobile-menu.open {
      transform: translateX(0);
    }

    .mobile-menu-nav {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-menu-nav a {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      font-weight: 500;
      padding: 12px 0;
      color: var(--charcoal);
      transition: var(--transition);
      border-bottom: 1px solid var(--warm-gray);
    }

    .mobile-menu-nav a:hover {
      color: var(--terracotta);
      padding-left: 8px;
    }

    .mobile-menu-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 16px 24px;
      background: var(--white);
      border-top: 1px solid var(--warm-gray);
      display: flex;
      justify-content: center;
      gap: 32px;
    }

    .mobile-menu-footer a {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--warm-gray-dark);
    }

    /* ===== BOTTOM NAV (MOBILE) ===== */
    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid var(--warm-gray);
      display: flex;
      justify-content: space-around;
      padding: 8px 0;
      padding-bottom: max(8px, env(safe-area-inset-bottom));
      z-index: 999;
    }

    .bottom-nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      padding: 4px 12px;
      color: var(--warm-gray-dark);
      transition: var(--transition);
      position: relative;
      font-size: 0.7rem;
      font-weight: 500;
    }

    .bottom-nav-item svg {
      width: 22px;
      height: 22px;
    }

    .bottom-nav-item.active,
    .bottom-nav-item:hover {
      color: var(--terracotta);
    }

    .bottom-nav-item .cart-badge {
      position: absolute;
      top: -2px;
      right: 2px;
      background: var(--terracotta);
      color: white;
      font-size: 0.6rem;
      font-weight: 700;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transform: scale(0);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .bottom-nav-item .cart-badge.visible {
      transform: scale(1);
    }

    /* ===== MAIN CONTENT ===== */
    main {
      padding-bottom: 80px;
    }

    /* ===== HERO ===== */
    .hero {
      position: relative;
      background: var(--gradient-hero);
      color: white;
      overflow: hidden;
      min-height: 85vh;
      display: flex;
      align-items: center;
    }

    .hero-bg-pattern {
      position: absolute;
      inset: 0;
      opacity: 0.08;
      background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0);
      background-size: 32px 32px;
    }

    .hero-inner {
      max-width: 1400px;
      margin: 0 auto;
      padding: 80px 24px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 48px;
      align-items: center;
      width: 100%;
      position: relative;
      z-index: 1;
    }

    .hero-content {
      text-align: center;
    }

    .hero-tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 6px 16px;
      border-radius: 100px;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 24px;
      backdrop-filter: blur(10px);
    }

    .hero h1 {
      font-family: var(--font-serif);
      font-size: clamp(2.25rem, 6vw, 4rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 20px;
      letter-spacing: -0.02em;
    }

    .hero h1 em {
      font-style: italic;
      color: #F4C4A8;
    }

    .hero-subtitle {
      font-size: clamp(1rem, 2.5vw, 1.2rem);
      opacity: 0.9;
      max-width: 520px;
      margin: 0 auto 32px;
      line-height: 1.6;
    }

    .hero-buttons {
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--gradient-accent);
      color: white;
      padding: 14px 32px;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: var(--transition);
      box-shadow: 0 4px 16px rgba(199, 121, 90, 0.4);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(199, 121, 90, 0.5);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.12);
      border: 2px solid rgba(255, 255, 255, 0.3);
      color: white;
      padding: 14px 32px;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.95rem;
      transition: var(--transition);
      backdrop-filter: blur(10px);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.2);
      border-color: rgba(255, 255, 255, 0.5);
    }

    .hero-image {
      display: none;
      position: relative;
    }

    .hero-image img {
      width: 100%;
      height: 500px;
      object-fit: cover;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-xl);
    }

    /* ===== MARQUEE ===== */
    .marquee {
      background: var(--white);
      border-bottom: 1px solid var(--warm-gray);
      overflow: hidden;
      padding: 12px 0;
    }

    .marquee-track {
      display: flex;
      animation: marquee 30s linear infinite;
      width: max-content;
    }

    .marquee-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 32px;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--charcoal);
      white-space: nowrap;
    }

    .marquee-item svg {
      width: 18px;
      height: 18px;
      color: var(--terracotta);
      flex-shrink: 0;
    }

    @keyframes marquee {
      0% {
        transform: translateX(0);
      }

      100% {
        transform: translateX(-50%);
      }
    }

    /* ===== SECTIONS ===== */
    .section {
      padding: 64px 24px;
      max-width: 1400px;
      margin: 0 auto;
    }

    .section-header {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-header h2 {
      font-family: var(--font-serif);
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      font-weight: 600;
      color: var(--charcoal);
      margin-bottom: 12px;
      letter-spacing: -0.02em;
    }

    .section-header p {
      color: var(--warm-gray-dark);
      max-width: 560px;
      margin: 0 auto;
      font-size: 1rem;
    }

    /* ===== CATEGORY GRID ===== */
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .category-card {
      position: relative;
      border-radius: var(--radius-md);
      overflow: hidden;
      aspect-ratio: 1;
      cursor: pointer;
      transition: var(--transition);
    }

    .category-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    .category-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .category-card:hover img {
      transform: scale(1.05);
    }

    .category-card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(36, 40, 36, 0.8) 0%, rgba(36, 40, 36, 0.1) 60%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 16px;
    }

    .category-card-overlay h3 {
      font-family: var(--font-serif);
      color: white;
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .category-card-overlay span {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.75rem;
      font-weight: 500;
    }

    /* ===== PRODUCT GRID ===== */
    .products-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .product-card {
      background: var(--white);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: var(--transition);
      cursor: pointer;
      border: 1px solid var(--warm-gray);
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: transparent;
    }

    .product-card-image {
      position: relative;
      aspect-ratio: 1;
      overflow: hidden;
      background: var(--gradient-card);
    }

    .product-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .product-card:hover .product-card-image img {
      transform: scale(1.05);
    }

    .product-badge {
      position: absolute;
      top: 8px;
      left: 8px;
      background: var(--terracotta);
      color: white;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 100px;
    }

    .product-wishlist-btn {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 36px;
      height: 36px;
      background: rgba(255, 255, 255, 0.9);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
      backdrop-filter: blur(10px);
    }

    .product-wishlist-btn:hover {
      background: white;
    }

    .product-wishlist-btn svg {
      width: 18px;
      height: 18px;
      color: var(--charcoal);
    }

    .product-wishlist-btn.active svg {
      color: var(--terracotta);
      fill: var(--terracotta);
    }

    .product-card-body {
      padding: 14px;
    }

    .product-card-body h3 {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 4px;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-card-body .product-category {
      font-size: 0.75rem;
      color: var(--warm-gray-dark);
      margin-bottom: 8px;
    }

    .product-price {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .product-price .current {
      font-size: 1rem;
      font-weight: 700;
      color: var(--forest);
    }

    .product-price .original {
      font-size: 0.8rem;
      color: var(--warm-gray-dark);
      text-decoration: line-through;
    }

    .quick-add-btn {
      position: absolute;
      bottom: 14px;
      right: 14px;
      width: 36px;
      height: 36px;
      background: var(--forest);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
      opacity: 0;
      transform: translateY(8px);
    }

    .product-card:hover .quick-add-btn {
      opacity: 1;
      transform: translateY(0);
    }

    .quick-add-btn:hover {
      background: var(--terracotta);
    }

    .quick-add-btn svg {
      width: 18px;
      height: 18px;
    }

    /* ===== EDITORIAL SECTION ===== */
    .editorial {
      background: var(--forest);
      color: white;
      padding: 80px 24px;
    }

    .editorial-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: center;
    }

    .editorial-content h2 {
      font-family: var(--font-serif);
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      font-weight: 600;
      line-height: 1.2;
      margin-bottom: 16px;
    }

    .editorial-content p {
      opacity: 0.85;
      line-height: 1.7;
      margin-bottom: 24px;
      max-width: 480px;
    }

    .editorial-image {
      border-radius: var(--radius-lg);
      overflow: hidden;
      aspect-ratio: 4/3;
    }

    .editorial-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ===== PURPOSE CARDS ===== */
    .purpose-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .purpose-card {
      position: relative;
      border-radius: var(--radius-md);
      overflow: hidden;
      aspect-ratio: 3/4;
      cursor: pointer;
      transition: var(--transition);
    }

    .purpose-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    .purpose-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .purpose-card:hover img {
      transform: scale(1.05);
    }

    .purpose-card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(36, 40, 36, 0.85) 0%, rgba(36, 40, 36, 0.05) 50%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 20px;
    }

    .purpose-card-overlay h3 {
      font-family: var(--font-serif);
      color: white;
      font-size: 1rem;
      font-weight: 600;
    }

    /* ===== REASSURANCE ===== */
    .reassurance {
      background: var(--white);
      border-top: 1px solid var(--warm-gray);
      border-bottom: 1px solid var(--warm-gray);
      padding: 48px 24px;
    }

    .reassurance-grid {
      max-width: 1400px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .reassurance-item {
      text-align: center;
      padding: 16px;
    }

    .reassurance-icon {
      width: 48px;
      height: 48px;
      background: var(--sage);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 12px;
    }

    .reassurance-icon svg {
      width: 22px;
      height: 22px;
      color: var(--forest);
    }

    .reassurance-item h4 {
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .reassurance-item p {
      font-size: 0.75rem;
      color: var(--warm-gray-dark);
    }

    /* ===== NEWSLETTER ===== */
    .newsletter {
      background: var(--gradient-hero);
      color: white;
      padding: 64px 24px;
      text-align: center;
    }

    .newsletter h2 {
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 3vw, 2rem);
      margin-bottom: 12px;
    }

    .newsletter p {
      opacity: 0.85;
      margin-bottom: 24px;
      max-width: 400px;
      margin-left: auto;
      margin-right: auto;
    }

    .newsletter-form {
      display: flex;
      gap: 8px;
      max-width: 440px;
      margin: 0 auto;
    }

    .newsletter-form input {
      flex: 1;
      padding: 14px 20px;
      border-radius: 100px;
      border: 2px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.1);
      color: white;
      font-size: 0.9rem;
      backdrop-filter: blur(10px);
    }

    .newsletter-form input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .newsletter-form input:focus {
      border-color: var(--terracotta);
      outline: none;
    }

    .newsletter-form button {
      padding: 14px 24px;
      background: var(--gradient-accent);
      color: white;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.9rem;
      transition: var(--transition);
      white-space: nowrap;
    }

    .newsletter-form button:hover {
      transform: translateY(-2px);
    }

    .newsletter-privacy {
      font-size: 0.7rem;
      opacity: 0.6;
      margin-top: 12px;
    }

    .newsletter-success {
      display: none;
      padding: 16px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: var(--radius-md);
      margin-top: 16px;
    }

    .newsletter-error {
      display: none;
      padding: 16px;
      background: rgba(255, 100, 100, 0.2);
      border-radius: var(--radius-md);
      margin-top: 16px;
      font-size: 0.85rem;
    }

    /* ===== FOOTER ===== */
    .footer {
      background: var(--charcoal);
      color: rgba(255, 255, 255, 0.7);
      padding: 48px 24px 120px;
    }

    .footer-inner {
      max-width: 1400px;
      margin: 0 auto;
    }

    .footer-top {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      margin-bottom: 32px;
    }

    .footer-brand .logo {
      color: white;
      font-size: 1.5rem;
      margin-bottom: 12px;
    }

    .footer-brand p {
      font-size: 0.85rem;
      line-height: 1.6;
      max-width: 300px;
    }

    .footer-column h4 {
      color: white;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 16px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .footer-column a {
      display: block;
      font-size: 0.85rem;
      padding: 4px 0;
      transition: var(--transition);
    }

    .footer-column a:hover {
      color: white;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      align-items: center;
      text-align: center;
    }

    .footer-bottom p {
      font-size: 0.8rem;
    }

    .footer-social {
      display: flex;
      gap: 16px;
    }

    .footer-social a {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .footer-social a:hover {
      background: var(--terracotta);
    }

    .footer-social svg {
      width: 18px;
      height: 18px;
    }

    /* ===== SHOP PAGE ===== */
    .shop-header {
      padding: 32px 24px 24px;
      background: var(--white);
      border-bottom: 1px solid var(--warm-gray);
    }

    .shop-header-inner {
      max-width: 1400px;
      margin: 0 auto;
    }

    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.8rem;
      color: var(--warm-gray-dark);
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .breadcrumb a {
      color: var(--warm-gray-dark);
      transition: var(--transition);
    }

    .breadcrumb a:hover {
      color: var(--terracotta);
    }

    .breadcrumb span {
      color: var(--charcoal);
      font-weight: 500;
    }

    .shop-header h1 {
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 600;
      margin-bottom: 8px;
    }

    .shop-header p {
      color: var(--warm-gray-dark);
      font-size: 0.9rem;
    }

    .shop-controls {
      padding: 16px 24px;
      background: var(--white);
      border-bottom: 1px solid var(--warm-gray);
      position: sticky;
      top: 64px;
      z-index: 100;
    }

    .shop-controls-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .shop-controls .result-count {
      font-size: 0.85rem;
      color: var(--warm-gray-dark);
      white-space: nowrap;
    }

    .shop-controls-actions {
      display: flex;
      gap: 8px;
    }

    .filter-btn,
    .sort-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border: 1px solid var(--warm-gray);
      border-radius: 100px;
      font-size: 0.8rem;
      font-weight: 500;
      transition: var(--transition);
      background: var(--white);
    }

    .filter-btn:hover,
    .sort-btn:hover {
      border-color: var(--terracotta);
    }

    .filter-btn svg,
    .sort-btn svg {
      width: 16px;
      height: 16px;
    }

    /* ===== FILTER DRAWER ===== */
    .filter-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 9998;
      opacity: 0;
      visibility: hidden;
      transition: var(--transition);
    }

    .filter-overlay.open {
      opacity: 1;
      visibility: visible;
    }

    .filter-drawer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--white);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      z-index: 9999;
      transform: translateY(100%);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      max-height: 85vh;
      overflow-y: auto;
      padding-bottom: max(24px, env(safe-area-inset-bottom));
    }

    .filter-drawer.open {
      transform: translateY(0);
    }

    .filter-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px 16px;
      border-bottom: 1px solid var(--warm-gray);
      position: sticky;
      top: 0;
      background: var(--white);
      z-index: 1;
    }

    .filter-drawer-header h3 {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 600;
    }

    .filter-drawer-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: var(--transition);
    }

    .filter-drawer-close:hover {
      background: var(--sage);
    }

    .filter-drawer-body {
      padding: 24px;
    }

    .filter-group {
      margin-bottom: 24px;
    }

    .filter-group h4 {
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 12px;
      color: var(--charcoal);
    }

    .filter-options {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .filter-option {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      cursor: pointer;
    }

    .filter-option input[type="checkbox"] {
      width: 20px;
      height: 20px;
      accent-color: var(--forest);
      cursor: pointer;
    }

    .filter-option label {
      font-size: 0.9rem;
      cursor: pointer;
    }

    .filter-range {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .filter-range input[type="number"] {
      width: 100px;
      padding: 8px 12px;
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
    }

    .filter-drawer-footer {
      padding: 16px 24px;
      border-top: 1px solid var(--warm-gray);
      display: flex;
      gap: 12px;
      position: sticky;
      bottom: 0;
      background: var(--white);
    }

    .filter-apply-btn {
      flex: 1;
      padding: 14px;
      background: var(--forest);
      color: white;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 0.9rem;
      transition: var(--transition);
    }

    .filter-apply-btn:hover {
      opacity: 0.9;
    }

    .filter-reset-btn {
      padding: 14px 20px;
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-sm);
      font-weight: 500;
      font-size: 0.9rem;
      transition: var(--transition);
    }

    .filter-reset-btn:hover {
      border-color: var(--charcoal);
    }

    /* ===== ACTIVE FILTER CHIPS ===== */
    .active-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 24px;
      max-width: 1400px;
    }

    .filter-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: var(--sage);
      border-radius: 100px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--forest);
    }

    .filter-chip button {
      width: 16px;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--forest);
    }

    /* ===== PRODUCT DETAIL ===== */
    .product-detail {
      max-width: 1400px;
      margin: 0 auto;
    }

    .pd-header {
      padding: 32px 24px 0;
      background: var(--white);
    }

    .pd-header .breadcrumb {
      margin-bottom: 16px;
    }

    .pd-gallery {
      aspect-ratio: 1;
      background: var(--gradient-card);
      position: relative;
      overflow: hidden;
    }

    .pd-gallery img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .pd-gallery-thumbnails {
      display: flex;
      gap: 8px;
      padding: 12px 24px;
      background: var(--white);
      overflow-x: auto;
    }

    .pd-gallery-thumbnails button {
      width: 64px;
      height: 64px;
      border: 2px solid transparent;
      border-radius: var(--radius-sm);
      overflow: hidden;
      flex-shrink: 0;
      transition: var(--transition);
    }

    .pd-gallery-thumbnails button.active {
      border-color: var(--terracotta);
    }

    .pd-gallery-thumbnails img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .pd-info {
      padding: 24px;
      background: var(--white);
    }

    .pd-info .product-category {
      font-size: 0.8rem;
      color: var(--warm-gray-dark);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pd-info h1 {
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 600;
      margin-bottom: 12px;
      line-height: 1.2;
    }

    .pd-price {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 16px;
    }

    .pd-price .current {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--forest);
    }

    .pd-price .original {
      font-size: 1rem;
      color: var(--warm-gray-dark);
      text-decoration: line-through;
    }

    .pd-price .discount {
      background: #FEE2E2;
      color: #DC2626;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 100px;
    }

    .pd-availability {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      color: var(--forest);
      font-weight: 500;
      margin-bottom: 20px;
    }

    .pd-availability .dot {
      width: 8px;
      height: 8px;
      background: #22C55E;
      border-radius: 50%;
    }

    .pd-quantity {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
    }

    .quantity-control {
      display: flex;
      align-items: center;
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-sm);
      overflow: hidden;
    }

    .quantity-control button {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--charcoal);
      transition: var(--transition);
    }

    .quantity-control button:hover {
      background: var(--sage);
    }

    .quantity-control input {
      width: 48px;
      height: 40px;
      text-align: center;
      border: none;
      border-left: 1px solid var(--warm-gray);
      border-right: 1px solid var(--warm-gray);
      font-weight: 600;
      font-size: 0.9rem;
    }

    .pd-actions {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
    }

    .pd-add-btn {
      flex: 1;
      padding: 16px 24px;
      background: var(--gradient-accent);
      color: white;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      transition: var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .pd-add-btn:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .pd-wishlist-btn {
      width: 52px;
      height: 52px;
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .pd-wishlist-btn:hover {
      border-color: var(--terracotta);
    }

    .pd-wishlist-btn svg {
      width: 22px;
      height: 22px;
      color: var(--charcoal);
    }

    .pd-wishlist-btn.active svg {
      color: var(--terracotta);
      fill: var(--terracotta);
    }

    /* Accordion */
    .accordion {
      margin-bottom: 24px;
    }

    .accordion-item {
      border-top: 1px solid var(--warm-gray);
    }

    .accordion-trigger {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0;
      font-weight: 600;
      font-size: 0.9rem;
      text-align: left;
      transition: var(--transition);
    }

    .accordion-trigger:hover {
      color: var(--terracotta);
    }

    .accordion-trigger svg {
      width: 20px;
      height: 20px;
      transition: transform var(--transition);
      flex-shrink: 0;
    }

    .accordion-item.open .accordion-trigger svg {
      transform: rotate(180deg);
    }

    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .accordion-item.open .accordion-content {
      max-height: 500px;
    }

    .accordion-body {
      padding-bottom: 16px;
      font-size: 0.9rem;
      line-height: 1.7;
      color: #555;
    }

    .accordion-body ul {
      padding-left: 20px;
    }

    .accordion-body li {
      margin-bottom: 4px;
    }

    /* ===== STICKY MOBILE BUY BAR ===== */
    .sticky-buy-bar {
      position: fixed;
      bottom: 56px;
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid var(--warm-gray);
      padding: 12px 24px;
      padding-bottom: max(12px, env(safe-area-inset-bottom));
      z-index: 998;
      display: none;
      align-items: center;
      gap: 12px;
    }

    .sticky-buy-bar .sticky-price {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--forest);
    }

    .sticky-buy-bar .sticky-btn {
      flex: 1;
      padding: 14px;
      background: var(--gradient-accent);
      color: white;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 0.9rem;
      text-align: center;
    }

    /* ===== CART DRAWER ===== */
    .cart-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 9998;
      opacity: 0;
      visibility: hidden;
      transition: var(--transition);
    }

    .cart-overlay.open {
      opacity: 1;
      visibility: visible;
    }

    .cart-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: 100%;
      max-width: 420px;
      height: 100vh;
      height: 100dvh;
      background: var(--white);
      z-index: 9999;
      transform: translateX(100%);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
    }

    .cart-drawer.open {
      transform: translateX(0);
    }

    .cart-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px;
      border-bottom: 1px solid var(--warm-gray);
    }

    .cart-drawer-header h3 {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      font-weight: 600;
    }

    .cart-drawer-items {
      flex: 1;
      overflow-y: auto;
      padding: 16px 24px;
    }

    .cart-empty {
      text-align: center;
      padding: 48px 24px;
    }

    .cart-empty svg {
      width: 48px;
      height: 48px;
      color: var(--warm-gray-dark);
      margin-bottom: 16px;
    }

    .cart-empty h4 {
      font-family: var(--font-serif);
      font-size: 1.1rem;
      margin-bottom: 8px;
    }

    .cart-empty p {
      font-size: 0.85rem;
      color: var(--warm-gray-dark);
      margin-bottom: 20px;
    }

    .cart-empty a {
      color: var(--terracotta);
      font-weight: 600;
      font-size: 0.9rem;
    }

    .cart-item {
      display: flex;
      gap: 12px;
      padding: 16px 0;
      border-bottom: 1px solid var(--warm-gray);
    }

    .cart-item-image {
      width: 80px;
      height: 80px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      flex-shrink: 0;
      background: var(--gradient-card);
    }

    .cart-item-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cart-item-info {
      flex: 1;
    }

    .cart-item-info h4 {
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 4px;
      line-height: 1.3;
    }

    .cart-item-info .variant {
      font-size: 0.75rem;
      color: var(--warm-gray-dark);
      margin-bottom: 8px;
    }

    .cart-item-controls {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cart-qty {
      display: flex;
      align-items: center;
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-sm);
      overflow: hidden;
    }

    .cart-qty button {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
    }

    .cart-qty span {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 0.85rem;
      border-left: 1px solid var(--warm-gray);
      border-right: 1px solid var(--warm-gray);
    }

    .cart-item-price {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--forest);
      white-space: nowrap;
    }

    .cart-item-remove {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--warm-gray-dark);
      transition: var(--transition);
      flex-shrink: 0;
    }

    .cart-item-remove:hover {
      color: #DC2626;
    }

    .cart-item-remove svg {
      width: 18px;
      height: 18px;
    }

    .cart-drawer-footer {
      padding: 20px 24px;
      border-top: 1px solid var(--warm-gray);
      background: var(--white);
    }

    .cart-summary {
      margin-bottom: 16px;
    }

    .cart-summary-row {
      display: flex;
      justify-content: space-between;
      padding: 4px 0;
      font-size: 0.9rem;
    }

    .cart-summary-row.total {
      font-weight: 700;
      font-size: 1.1rem;
      padding-top: 8px;
      border-top: 1px solid var(--warm-gray);
      margin-top: 8px;
    }

    .cart-summary-row.total .amount {
      color: var(--forest);
    }

    .cart-checkout-btn {
      width: 100%;
      padding: 16px;
      background: var(--gradient-accent);
      color: white;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      transition: var(--transition);
      margin-bottom: 8px;
    }

    .cart-checkout-btn:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .cart-continue {
      width: 100%;
      padding: 12px;
      text-align: center;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--warm-gray-dark);
      transition: var(--transition);
    }

    .cart-continue:hover {
      color: var(--charcoal);
    }

    /* ===== CART PAGE ===== */
    .cart-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 24px 120px;
    }

    .cart-page h1 {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      margin-bottom: 24px;
    }

    .cart-page-items {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .cart-page-item {
      display: flex;
      gap: 16px;
      padding: 20px 0;
      border-bottom: 1px solid var(--warm-gray);
    }

    .cart-page-item-image {
      width: 100px;
      height: 100px;
      border-radius: var(--radius-md);
      overflow: hidden;
      flex-shrink: 0;
      background: var(--gradient-card);
    }

    .cart-page-item-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cart-page-item-info {
      flex: 1;
    }

    .cart-page-item-info h3 {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .cart-page-item-info .variant {
      font-size: 0.8rem;
      color: var(--warm-gray-dark);
      margin-bottom: 12px;
    }

    .cart-page-item-info .price {
      font-weight: 700;
      font-size: 1rem;
      color: var(--forest);
    }

    .cart-page-summary {
      background: var(--white);
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-md);
      padding: 24px;
      margin-top: 24px;
    }

    .cart-page-summary h3 {
      font-family: var(--font-serif);
      font-size: 1.1rem;
      margin-bottom: 16px;
    }

    .cart-page-summary .cart-summary-row {
      padding: 8px 0;
    }

    .cart-page-summary .cart-summary-row.total {
      font-size: 1.25rem;
      padding-top: 12px;
      margin-top: 12px;
    }

    /* ===== SEARCH OVERLAY ===== */
    .search-overlay {
      position: fixed;
      inset: 0;
      background: var(--ivory);
      z-index: 9999;
      transform: translateY(-100%);
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
    }

    .search-overlay.open {
      transform: translateY(0);
    }

    .search-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 24px;
      border-bottom: 1px solid var(--warm-gray);
    }

    .search-back {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: var(--transition);
      flex-shrink: 0;
    }

    .search-back:hover {
      background: var(--sage);
    }

    .search-input-wrap {
      flex: 1;
      position: relative;
    }

    .search-input-wrap input {
      width: 100%;
      padding: 12px 16px;
      padding-right: 40px;
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-sm);
      font-size: 1rem;
      background: var(--white);
    }

    .search-input-wrap input:focus {
      border-color: var(--terracotta);
      outline: none;
    }

    .search-clear {
      position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--warm-gray-dark);
    }

    .search-body {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
    }

    .search-recent h4 {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--warm-gray-dark);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }

    .search-recent-items {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 24px;
    }

    .search-recent-item {
      padding: 8px 16px;
      background: var(--white);
      border: 1px solid var(--warm-gray);
      border-radius: 100px;
      font-size: 0.85rem;
      transition: var(--transition);
    }

    .search-recent-item:hover {
      border-color: var(--terracotta);
    }

    .search-suggestions h4 {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--warm-gray-dark);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 12px;
    }

    .search-suggestion-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 0;
      border-bottom: 1px solid var(--warm-gray);
      cursor: pointer;
    }

    .search-suggestion-item img {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-sm);
      object-fit: cover;
      background: var(--gradient-card);
    }

    .search-suggestion-item .info h5 {
      font-size: 0.9rem;
      font-weight: 600;
    }

    .search-suggestion-item .info span {
      font-size: 0.8rem;
      color: var(--warm-gray-dark);
    }

    /* ===== TOAST NOTIFICATION ===== */
    .toast {
      position: fixed;
      top: 80px;
      left: 50%;
      transform: translateX(-50%) translateY(-20px);
      background: var(--charcoal);
      color: white;
      padding: 12px 24px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 500;
      z-index: 10000;
      opacity: 0;
      transition: all 0.3s ease;
      pointer-events: none;
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
      max-width: 90vw;
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    .toast svg {
      width: 18px;
      height: 18px;
      color: #22C55E;
      flex-shrink: 0;
    }

    /* ===== WISHLIST PAGE ===== */
    .wishlist-page {
      max-width: 1400px;
      margin: 0 auto;
      padding: 32px 24px 120px;
    }

    .wishlist-page h1 {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      margin-bottom: 24px;
    }

    .wishlist-empty {
      text-align: center;
      padding: 64px 24px;
    }

    .wishlist-empty svg {
      width: 64px;
      height: 64px;
      color: var(--warm-gray-dark);
      margin-bottom: 16px;
    }

    .wishlist-empty h3 {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      margin-bottom: 8px;
    }

    .wishlist-empty p {
      color: var(--warm-gray-dark);
      margin-bottom: 24px;
    }

    /* ===== CHECKOUT PROTOTYPE ===== */
    .checkout-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 32px 24px 120px;
    }

    .checkout-page h1 {
      font-family: var(--font-serif);
      font-size: 1.75rem;
      margin-bottom: 8px;
    }

    .checkout-page .subtitle {
      color: var(--warm-gray-dark);
      margin-bottom: 32px;
    }

    .checkout-steps {
      display: flex;
      gap: 0;
      margin-bottom: 32px;
      overflow-x: auto;
    }

    .checkout-step {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--warm-gray-dark);
      white-space: nowrap;
    }

    .checkout-step.active {
      color: var(--terracotta);
    }

    .checkout-step.completed {
      color: var(--forest);
    }

    .checkout-step .step-num {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--warm-gray);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 700;
    }

    .checkout-step.active .step-num {
      background: var(--terracotta);
      color: white;
    }

    .checkout-step.completed .step-num {
      background: var(--forest);
      color: white;
    }

    .checkout-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group label {
      font-size: 0.85rem;
      font-weight: 600;
    }

    .form-group input,
    .form-group select {
      padding: 12px 16px;
      border: 1px solid var(--warm-gray);
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      transition: var(--transition);
    }

    .form-group input:focus,
    .form-group select:focus {
      border-color: var(--terracotta);
      outline: none;
    }

    .form-group .error {
      color: #DC2626;
      font-size: 0.8rem;
      display: none;
    }

    .form-group.has-error input,
    .form-group.has-error select {
      border-color: #DC2626;
    }

    .form-group.has-error .error {
      display: block;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .checkout-btn {
      width: 100%;
      padding: 16px;
      background: var(--gradient-accent);
      color: white;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      margin-top: 8px;
    }

    /* ===== LOADING SKELETON ===== */
    .skeleton {
      background: linear-gradient(90deg, var(--warm-gray) 25%, #f0ece6 50%, var(--warm-gray) 75%);
      background-size: 200% 100%;
      animation: skeleton-loading 1.5s infinite;
      border-radius: var(--radius-sm);
    }

    @keyframes skeleton-loading {
      0% {
        background-position: 200% 0;
      }

      100% {
        background-position: -200% 0;
      }
    }

    /* ===== PAGE TRANSITIONS ===== */
    .page {
      display: none;
      opacity: 0;
      animation: pageIn 0.4s ease forwards;
    }

    .page.active {
      display: block;
    }

    @keyframes pageIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ===== SCROLL ANIMATIONS ===== */
    .fade-up {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ===== RESPONSIVE ===== */
    @media (min-width: 640px) {
      .categories-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .products-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }

      .purpose-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
      }

      .reassurance-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    @media (min-width: 768px) {
      .nav-desktop {
        display: flex;
      }

      .mobile-menu-btn {
        display: none;
      }

      .bottom-nav {
        display: none;
      }

      main {
        padding-bottom: 0;
      }

      .footer {
        padding-bottom: 48px;
      }

      .sticky-buy-bar {
        display: none !important;
      }

      .hero-inner {
        grid-template-columns: 1fr 1fr;
        text-align: left;
      }

      .hero-content {
        text-align: left;
      }

      .hero-subtitle {
        margin: 0 0 32px;
      }

      .hero-buttons {
        flex-direction: row;
        justify-content: flex-start;
      }

      .hero-image {
        display: block;
      }

      .editorial-inner {
        grid-template-columns: 1fr 1fr;
      }

      .footer-top {
        grid-template-columns: 2fr 1fr 1fr 1fr;
      }

      .footer-bottom {
        flex-direction: row;
        justify-content: space-between;
      }

      .categories-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .products-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .purpose-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .filter-drawer {
        max-width: 400px;
        left: auto;
        right: 0;
        bottom: 0;
        top: 0;
        border-radius: var(--radius-lg) 0 0 var(--radius-lg);
        transform: translateX(100%);
      }

      .filter-drawer.open {
        transform: translateX(0);
      }
    }

    @media (min-width: 1024px) {
      .categories-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .products-grid {
        grid-template-columns: repeat(5, 1fr);
        gap: 24px;
      }

      .section {
        padding: 80px 48px;
      }

      .hero-inner {
        padding: 100px 48px;
      }

      .pd-gallery {
        aspect-ratio: 4/3;
      }
    }

    @media (min-width: 1440px) {
      .products-grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }

    /* ===== REDUCED MOTION ===== */
    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }

      .marquee-track {
        animation: none;
      }

      .fade-up {
        opacity: 1;
        transform: none;
      }
    }

    /* ===== UTILITIES ===== */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .text-center {
      text-align: center;
    }

    .mt-4 {
      margin-top: 16px;
    }

    .mb-4 {
      margin-bottom: 16px;
    }
  </style>
</head>

<body>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Toast Notification -->
  <div class="toast" id="toast" role="alert" aria-live="polite">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
      stroke-linejoin="round">
      <path d="M20 6L9 17l-5-5" />
    </svg>
    <span id="toast-message"></span>
  </div>

  <!-- Announcement Bar -->
  <div class="announcement-bar" id="announcement-bar">
    Free delivery on orders over ₦15,000 · <a href="#" onclick="navigateTo('shop')">Shop Now</a>
  </div>

  <!-- Header -->
  <header class="header" id="header">
    <div class="header-inner">
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <a href="#" class="logo" onclick="navigateTo('home')">PRESH<span>WORD</span></a>
      <nav class="nav-desktop" role="navigation" aria-label="Main navigation">
        <a href="#" onclick="navigateTo('shop')" class="active">Shop All</a>
        <a href="#" onclick="navigateTo('shop', {category: 'cookware'})">Kitchen & Cooking</a>
        <a href="#" onclick="navigateTo('shop', {category: 'appliances'})">Appliances</a>
        <a href="#" onclick="navigateTo('shop', {category: 'tableware'})">Home & Dining</a>
        <a href="#" onclick="navigateTo('shop', {category: 'kids'})">Kids</a>
      </nav>
      <div class="header-actions">
        <button class="header-btn" onclick="openSearch()" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
        <button class="header-btn" onclick="navigateTo('wishlist')" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </button>
        <button class="header-btn" onclick="openCart()" aria-label="Shopping bag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
            <line x1="3" y1="6" x2="21" y2="6" />
            <path d="M16 10a4 4 0 0 1-8 0" />
          </svg>
          <span class="cart-count" id="cart-count-header">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Navigation menu">
    <nav class="mobile-menu-nav" aria-label="Mobile navigation">
      <a href="#" onclick="navigateTo('home'); closeMobileMenu()">Home</a>
      <a href="#" onclick="navigateTo('shop'); closeMobileMenu()">Shop All</a>
      <a href="#" onclick="navigateTo('shop', {category: 'cookware'}); closeMobileMenu()">Kitchen & Cooking</a>
      <a href="#" onclick="navigateTo('shop', {category: 'appliances'}); closeMobileMenu()">Appliances</a>
      <a href="#" onclick="navigateTo('shop', {category: 'tableware'}); closeMobileMenu()">Home & Dining</a>
      <a href="#" onclick="navigateTo('shop', {category: 'kids'}); closeMobileMenu()">Kids</a>
      <a href="#" onclick="navigateTo('wishlist'); closeMobileMenu()">Wishlist</a>
    </nav>
    <div class="mobile-menu-footer">
      <a href="#" onclick="navigateTo('checkout'); closeMobileMenu()">Checkout</a>
      <a href="#" onclick="closeMobileMenu()">Help</a>
    </div>
  </div>

  <!-- Search Overlay -->
  <div class="search-overlay" id="search-overlay" role="dialog" aria-label="Search">
    <div class="search-header">
      <button class="search-back" onclick="closeSearch()" aria-label="Close search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
      </button>
      <div class="search-input-wrap">
        <input type="text" id="search-input" placeholder="Search kitchenware, appliances..." autocomplete="off"
          aria-label="Search products">
        <button class="search-clear" onclick="clearSearch()" aria-label="Clear search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>
    <div class="search-body" id="search-body">
      <div class="search-recent" id="search-recent">
        <h4>Recent Searches</h4>
        <div class="search-recent-items" id="search-recent-items"></div>
      </div>
      <div class="search-suggestions" id="search-suggestions">
        <h4>Popular Products</h4>
        <div id="search-suggestions-list"></div>
      </div>
    </div>
  </div>

  <!-- Filter Drawer -->
  <div class="filter-overlay" id="filter-overlay" onclick="closeFilters()"></div>
  <div class="filter-drawer" id="filter-drawer" role="dialog" aria-label="Filters">
    <div class="filter-drawer-header">
      <h3>Filters</h3>
      <button class="filter-drawer-close" onclick="closeFilters()" aria-label="Close filters">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <div class="filter-drawer-body">
      <div class="filter-group">
        <h4>Category</h4>
        <div class="filter-options" id="filter-categories"></div>
      </div>
      <div class="filter-group">
        <h4>Price Range</h4>
        <div class="filter-range">
          <input type="number" id="filter-price-min" placeholder="Min" min="0">
          <span>—</span>
          <input type="number" id="filter-price-max" placeholder="Max" min="0">
        </div>
      </div>
      <div class="filter-group">
        <h4>Availability</h4>
        <div class="filter-options">
          <div class="filter-option">
            <input type="checkbox" id="filter-instock" checked>
            <label for="filter-instock">In Stock</label>
          </div>
          <div class="filter-option">
            <input type="checkbox" id="filter-sale">
            <label for="filter-sale">On Sale</label>
          </div>
        </div>
      </div>
    </div>
    <div class="filter-drawer-footer">
      <button class="filter-reset-btn" onclick="resetFilters()">Reset</button>
      <button class="filter-apply-btn" onclick="applyFilters()">Apply Filters</button>
    </div>
  </div>

  <!-- Cart Drawer -->
  <div class="cart-overlay" id="cart-overlay" onclick="closeCart()"></div>
  <div class="cart-drawer" id="cart-drawer" role="dialog" aria-label="Shopping cart">
    <div class="cart-drawer-header">
      <h3>Your Bag (<span id="cart-count-drawer">0</span>)</h3>
      <button class="search-back" onclick="closeCart()" aria-label="Close cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
    <div class="cart-drawer-items" id="cart-drawer-items"></div>
    <div class="cart-drawer-footer" id="cart-drawer-footer" style="display:none;"></div>
  </div>

  <!-- Main Content -->
  <main id="main-content">

    <!-- ===== HOME PAGE ===== -->
    <div class="page active" id="page-home">
      <!-- Hero -->
      <section class="hero">
        <div class="hero-bg-pattern"></div>
        <div class="hero-inner">
          <div class="hero-content fade-up">
            <span class="hero-tag">✦ Curated for Your Home</span>
            <h1>Every Meal Deserves<br><em>Beautiful Tools</em></h1>
            <p class="hero-subtitle">Thoughtfully chosen kitchenware, cookware, and dining essentials — designed for the
              way you really live and cook.</p>
            <div class="hero-buttons">
              <a href="#" class="btn-primary" onclick="navigateTo('shop')">
                Shop All Products
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
              <a href="#" class="btn-secondary" onclick="navigateTo('shop', {category: 'collections'})">
                Explore Collections
              </a>
