      { id: 7, name: "Porcelain Dinner Plate Set (6pc)", category: "tableware", price: 12500, originalPrice: null, image: "https://images.unsplash.com/photo-1615865417491-9941019fbc00?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1615865417491-9941019fbc00?w=800&h=600&fit=crop"], description: "Elegant white porcelain dinner plates. Chip-resistant and microwave safe. Perfect for everyday dining or special occasions.", specs: { material: "Fine porcelain", diameter: "27cm", pieces: "6", care: "Dishwasher and microwave safe" }, inStock: true, isNew: false, onSale: false },
      { id: 8, name: "Kids Silicone Plate & Bowl Set", category: "kids", price: 5500, originalPrice: 7000, image: "https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?w=800&h=600&fit=crop"], description: "BPA-free silicone plates and bowls with suction base. Perfect for little ones learning to self-feed. Ages 6m+.", specs: { material: "Food-grade silicone", age: "6 months+", pieces: "4 (2 plates, 2 bowls)", care: "Dishwasher safe" }, inStock: true, isNew: true, onSale: true },
      { id: 9, name: "Glass Food Storage Containers (5pc)", category: "storage", price: 11000, originalPrice: null, image: "https://images.unsplash.com/photo-1584568694244-14fbdf83bd30?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1584568694244-14fbdf83bd30?w=800&h=600&fit=crop"], description: "Airtight borosilicate glass containers with bamboo lids. Oven, microwave, and freezer safe.", specs: { material: "Borosilicate glass, bamboo lids", pieces: "5", capacities: "300ml-1200ml", care: "Dishwasher safe (lids hand wash)" }, inStock: true, isNew: false, onSale: false },
      { id: 10, name: "Stainless Steel Mixing Bowls (3pc)", category: "utensils", price: 5800, originalPrice: null, image: "https://images.unsplash.com/photo-1541544741938-0af808871cc0?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1541544741938-0af808871cc0?w=800&h=600&fit=crop"], description: "Nesting stainless steel mixing bowls with non-slip bases. Sizes: 1.5L, 2.5L, 4L.", specs: { material: "18/10 stainless steel", pieces: "3", capacities: "1.5L, 2.5L, 4L", care: "Dishwasher safe" }, inStock: true, isNew: false, onSale: false },
      { id: 11, name: "Cast Iron Dutch Oven 5.5L", category: "cookware", price: 28000, originalPrice: 35000, image: "https://images.unsplash.com/photo-1585515320310-259814833e62?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1585515320310-259814833e62?w=800&h=600&fit=crop"], description: "Premium enameled cast iron Dutch oven for braising, stewing, and baking. Even heat distribution for perfect results.", specs: { material: "Enameled cast iron", capacity: "5.5L", ovenSafe: "Up to 260°C", care: "Hand wash recommended" }, inStock: true, isNew: true, onSale: true },
      { id: 12, name: "Ceramic Coffee Mug Set (4pc)", category: "tableware", price: 4800, originalPrice: null, image: "https://images.unsplash.com/photo-1514228742587-6b1558fcca3d?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1514228742587-6b1558fcca3d?w=800&h=600&fit=crop"], description: "Handmade ceramic mugs in earthy tones. Each piece is unique. 350ml capacity.", specs: { material: "Stoneware ceramic", capacity: "350ml each", pieces: "4", care: "Dishwasher and microwave safe" }, inStock: true, isNew: false, onSale: false },
      { id: 13, name: "Bamboo Cutting Board Set (3pc)", category: "utensils", price: 6500, originalPrice: null, image: "https://images.unsplash.com/photo-1606760227091-3dd870d97f1d?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1606760227091-3dd870d97f1d?w=800&h=600&fit=crop"], description: "Sustainable bamboo cutting boards in three sizes. Naturally antimicrobial and gentle on knife edges.", specs: { material: "Moso bamboo", sizes: "Small, Medium, Large", care: "Hand wash, oil monthly" }, inStock: true, isNew: false, onSale: false },
      { id: 14, name: "Toaster 2-Slice Stainless", category: "appliances", price: 14500, originalPrice: 18000, image: "https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1583743814966-8936f5b7be1a?w=800&h=600&fit=crop"], description: "Compact 2-slice toaster with 6 browning settings, defrost and reheat functions. Extra-wide slots for bagels.", specs: { power: "850W", slots: "2", settings: "6 browning levels", features: "Defrost, reheat, cancel" }, inStock: true, isNew: false, onSale: true },
      { id: 15, name: "Kids Stainless Steel Lunch Box", category: "kids", price: 4200, originalPrice: null, image: "https://images.unsplash.com/photo-1606851094655-b2593a9af63f?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1606851094655-b2593a9af63f?w=800&h=600&fit=crop"], description: "Durable stainless steel bento-style lunch box with 3 compartments. Leak-proof and eco-friendly.", specs: { material: "Food-grade 304 stainless steel", compartments: "3", capacity: "700ml total", care: "Hand wash recommended" }, inStock: true, isNew: true, onSale: false },
      { id: 16, name: "Copper Moscow Mule Mugs (2pc)", category: "tableware", price: 7500, originalPrice: null, image: "https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1551024709-8f23befc6f87?w=800&h=600&fit=crop"], description: "Pure copper mugs with brass handles. Traditional Moscow Mule design with lacquer finish to prevent tarnishing.", specs: { material: "Pure copper with brass handle", capacity: "450ml each", pieces: "2", care: "Hand wash only" }, inStock: true, isNew: false, onSale: false },
      { id: 17, name: "Silicone Baking Mat Set", category: "utensils", price: 3800, originalPrice: null, image: "https://images.unsplash.com/photo-1558961363-fa8fdf82db35?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1558961363-fa8fdf82db35?w=800&h=600&fit=crop"], description: "Non-stick silicone baking mats. Reusable, eco-friendly alternative to parchment paper. Set of 3 sizes.", specs: { material: "Food-grade silicone", pieces: "3", sizes: "30x40, 28x38, 24x35cm", heatResistant: "Up to 230°C" }, inStock: true, isNew: false, onSale: false },
      { id: 18, name: "Vacuum Insulated Flask 500ml", category: "storage", price: 6800, originalPrice: 8500, image: "https://images.unsplash.com/photo-1602143407151-7111542de6e8?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1602143407151-7111542de6e8?w=800&h=600&fit=crop"], description: "Double-wall vacuum insulation keeps drinks hot for 12h or cold for 24h. Leak-proof lid with one-hand operation.", specs: { material: "Stainless steel 18/8", capacity: "500ml", insulation: "Double-wall vacuum", care: "Hand wash recommended" }, inStock: true, isNew: true, onSale: true },
      { id: 19, name: "Children's Bamboo Dinner Set", category: "kids", price: 3500, originalPrice: null, image: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=800&h=600&fit=crop"], description: "Eco-friendly bamboo fiber dinner set with plate, bowl, and cup. BPA-free, lightweight, and virtually unbreakable.", specs: { material: "Bamboo fiber, cornstarch", age: "2 years+", pieces: "3", care: "Hand wash, not microwave safe" }, inStock: true, isNew: false, onSale: false },
      { id: 20, name: "Premium Wok 32cm Carbon Steel", category: "cookware", price: 18500, originalPrice: null, image: "https://images.unsplash.com/photo-1512058564366-18510be2db19?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1512058564366-18510be2db19?w=800&h=600&fit=crop"], description: "Traditional carbon steel wok for authentic stir-frying. Pre-seasoned and ready to use. Develops natural non-stick patina over time.", specs: { material: "Carbon steel", diameter: "32cm", handle: "Wooden", care: "Hand wash, season after use" }, inStock: true, isNew: true, onSale: false },
      { id: 21, name: "Matte Black Cutlery Set (24pc)", category: "tableware", price: 16500, originalPrice: 22000, image: "https://images.unsplash.com/photo-1584269600464-37b1b58a9fe7?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1584269600464-37b1b58a9fe7?w=800&h=600&fit=crop"], description: "Modern minimalist 24-piece cutlery set forged from premium stainless steel with an electroplated matte black finish. Service for 6.", specs: { material: "18/10 Stainless Steel", finish: "Matte Black PVD", pieces: "24 (6 forks, 6 knives, 6 soup spoons, 6 teaspoons)", care: "Hand wash recommended" }, inStock: true, isNew: true, onSale: true },
      { id: 22, name: "Airtight Glass Spice Jars with Bamboo Rack (12pc)", category: "storage", price: 9200, originalPrice: null, image: "https://images.unsplash.com/photo-1584269600519-112d071b35e6?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1584269600519-112d071b35e6?w=800&h=600&fit=crop"], description: "Keep your kitchen spices organized and fresh with 12 borosilicate jars, natural bamboo lids, and an expandable 2-tier display rack.", specs: { material: "Borosilicate glass & bamboo", pieces: "12 jars + 1 rack", capacity: "150ml per jar", features: "Airtight silicone seal, labels included" }, inStock: true, isNew: false, onSale: false },
      { id: 23, name: "Natural Bristle Dish Brush & Ceramic Soap Set", category: "cleaning", price: 4200, originalPrice: 5500, image: "https://images.unsplash.com/photo-1585837575652-267c041d77d4?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1585837575652-267c041d77d4?w=800&h=600&fit=crop"], description: "Eco-friendly sisal fiber scrubbing brushes with ergonomic beechwood handle and a matching ceramic self-draining soap dish.", specs: { material: "Beechwood, sisal fiber, ceramic", pieces: "3 (2 brush heads, 1 base)", care: "Air dry after use" }, inStock: true, isNew: true, onSale: true },
      { id: 24, name: "Organic Cotton Waffle Kitchen Towels (4pc)", category: "cleaning", price: 5800, originalPrice: null, image: "https://images.unsplash.com/photo-1563453392212-326f5e854473?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1563453392212-326f5e854473?w=800&h=600&fit=crop"], description: "Ultra-absorbent, lint-free waffle weave kitchen towels made from 100% certified organic Turkish cotton in natural earthy tones.", specs: { material: "100% Organic Cotton", pieces: "4", dimensions: "45 x 65 cm", care: "Machine wash warm" }, inStock: true, isNew: false, onSale: false },
      { id: 25, name: "The Master Chef Starter Bundle", category: "collections", price: 48000, originalPrice: 62000, image: "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=800&h=600&fit=crop"], description: "The ultimate culinary collection featuring our 28cm frying pan, 6-piece knife block, bamboo cutting board, and wooden utensil set.", specs: { includes: "Frying Pan, Knife Set, Cutting Board, Utensils", pieces: "15 total pieces", warranty: "2 years" }, inStock: true, isNew: true, onSale: true },
      { id: 26, name: "Sunday Family Feast Cookware Set", category: "collections", price: 54000, originalPrice: 68000, image: "https://images.unsplash.com/photo-1544025162-d76694265947?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1544025162-d76694265947?w=800&h=600&fit=crop"], description: "Everything needed for large family dinners, weekend gatherings, and celebrations. Includes Dutch oven, carbon steel wok, and serving dish.", specs: { includes: "5.5L Dutch Oven, 32cm Wok, 2.5L Casserole", material: "Cast iron, carbon steel, stoneware", warranty: "3 years" }, inStock: true, isNew: false, onSale: true },
      { id: 27, name: "Artisan Morning Coffee & Breakfast Kit", category: "collections", price: 22000, originalPrice: 28000, image: "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=400&h=400&fit=crop", gallery: ["https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&h=600&fit=crop"], description: "Transform your morning routine with our fast-boil stainless kettle, 4 handmade ceramic mugs, and matching honey drizzle spoon.", specs: { includes: "1.7L Kettle, 4 Ceramic Mugs, Spoon", power: "2200W", pieces: "6" }, inStock: true, isNew: true, onSale: true }
    ];

    const categories = [
      { id: "cookware", name: "Cookware", count: 5, image: "https://images.unsplash.com/photo-1556909114-44e3e70034e2?w=400&h=400&fit=crop" },
      { id: "utensils", name: "Kitchen Utensils", count: 4, image: "https://images.unsplash.com/photo-1590794056226-79ef3a8147e1?w=400&h=400&fit=crop" },
      { id: "appliances", name: "Small Appliances", count: 3, image: "https://images.unsplash.com/photo-1570222094114-d054a817e56b?w=400&h=400&fit=crop" },
      { id: "tableware", name: "Cutlery & Tableware", count: 4, image: "https://images.unsplash.com/photo-1578749556568-bc2c40e68b61?w=400&h=400&fit=crop" },
      { id: "kids", name: "Children's Dining", count: 3, image: "https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?w=400&h=400&fit=crop" },
      { id: "storage", name: "Storage & Organization", count: 3, image: "https://images.unsplash.com/photo-1584568694244-14fbdf83bd30?w=400&h=400&fit=crop" },
      { id: "cleaning", name: "Cleaning Essentials", count: 2, image: "https://images.unsplash.com/photo-1563453392212-326f5e854473?w=400&h=400&fit=crop" },
      { id: "collections", name: "Curated Collections", count: 3, image: "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=400&h=400&fit=crop" }
    ];

    const purposes = [
      { name: "Everyday Essentials", image: "https://images.unsplash.com/photo-1556909114-44e3e70034e2?w=400&h=500&fit=crop" },
      { name: "Appliances That Make Life Easier", image: "https://images.unsplash.com/photo-1570222094114-d054a817e56b?w=400&h=500&fit=crop" },
      { name: "Family Dining", image: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=400&h=500&fit=crop" },
      { name: "Setting Up a New Home", image: "https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=400&h=500&fit=crop" }
    ];

    // ===== STATE =====
    let cart = JSON.parse(localStorage.getItem('preshword_cart') || '[]');
    let wishlist = JSON.parse(localStorage.getItem('preshword_wishlist') || '[]');
    let recentSearches = JSON.parse(localStorage.getItem('preshword_recent_searches') || '[]');
    let currentSort = 'recommended';
    let activeFilters = { category: null, priceMin: null, priceMax: null, inStock: true, sale: false };
    let currentPage = 'home';

    // ===== FORMAT PRICE =====
    function formatPrice(n) { return '₦' + n.toLocaleString(); }

    // ===== TOAST =====
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').textContent = message;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    // ===== NAVIGATION =====
    function navigateTo(page, params = {}) {
      if (typeof window !== 'undefined' && window.event && window.event.preventDefault) {
        window.event.preventDefault();
      }
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.bottom-nav-item').forEach(n => n.classList.remove('active'));

      const pageEl = document.getElementById('page-' + page);
      if (pageEl) {
        pageEl.classList.add('active');
        pageEl.style.animation = 'none';
        pageEl.offsetHeight;
        pageEl.style.animation = '';
      }

      currentPage = page;
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Update bottom nav
      const navMap = { home: 0, shop: 1, appliances: 2, cart: 3, wishlist: 4 };
      let navIdx = navMap[page] ?? -1;
      if (page === 'shop' && params.category === 'appliances') {
        navIdx = 2;
      }
      if (navIdx >= 0) {
        document.querySelectorAll('.bottom-nav-item')[navIdx]?.classList.add('active');
      }

      // Render page content
      if (page === 'shop') renderShop(params);
      if (page === 'product') renderProductDetail(params.id);
      if (page === 'cart') renderCartPage();
      if (page === 'wishlist') renderWishlistPage();
      if (page === 'checkout') renderCheckoutPage();

      updateCartBadges();
    }

    // ===== HEADER SCROLL =====
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const header = document.getElementById('header');
      if (window.scrollY > 50) {
        header.classList.add('shrunk');
      } else {
        header.classList.remove('shrunk');
      }
      lastScroll = window.scrollY;
    });

    // ===== MOBILE MENU =====
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('open');
      mobileMenu.classList.toggle('open');
      mobileMenuBtn.classList.toggle('open');
      mobileMenuBtn.setAttribute('aria-expanded', !isOpen);
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    function closeMobileMenu() {
      mobileMenu.classList.remove('open');
      mobileMenuBtn.classList.remove('open');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // ===== SEARCH =====
    function openSearch() {
      document.getElementById('search-overlay').classList.add('open');
      document.body.style.overflow = 'hidden';
      setTimeout(() => document.getElementById('search-input').focus(), 300);
      renderRecentSearches();
      renderPopularSuggestions();
    }

    function closeSearch() {
      document.getElementById('search-overlay').classList.remove('open');
      document.body.style.overflow = '';
    }

    function clearSearch() {
      document.getElementById('search-input').value = '';
      renderRecentSearches();
      renderPopularSuggestions();
    }

    document.getElementById('search-input').addEventListener('input', function (e) {
      const query = e.target.value.toLowerCase().trim();
      if (query.length > 0) {
        renderSearchResults(query);
      } else {
        renderRecentSearches();
        renderPopularSuggestions();
      }
    });

    document.getElementById('search-input').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        const query = this.value.trim();
        if (query) {
          recentSearches = [query, ...recentSearches.filter(s => s !== query)].slice(0, 5);
          localStorage.setItem('preshword_recent_searches', JSON.stringify(recentSearches));
          closeSearch();
          navigateTo('shop');
          document.getElementById('search-input').value = '';
          // Filter by search
          activeFilters.search = query;
          renderShop({});
        }
      }
    });

    function renderRecentSearches() {
      const container = document.getElementById('search-recent-items');
      const section = document.getElementById('search-recent');
      if (recentSearches.length === 0) {
        section.style.display = 'none';
        return;
      }
      section.style.display = '';
      container.innerHTML = recentSearches.map(s =>
        `<button class="search-recent-item" onclick="document.getElementById('search-input').value='${s}'; renderSearchResults('${s}')">${s}</button>`
      ).join('');
    }

    function renderPopularSuggestions() {
      const list = document.getElementById('search-suggestions-list');
      const section = document.getElementById('search-suggestions');
      const popular = products.slice(0, 6);
      list.innerHTML = popular.map(p => `
    <div class="search-suggestion-item" onclick="closeSearch(); navigateTo('product', {id: ${p.id}})">
      <img src="${p.image}" alt="${p.name}" loading="lazy">
      <div class="info">
        <h5>${p.name}</h5>
        <span>${formatPrice(p.price)}</span>
      </div>
    </div>
  `).join('');
    }

    function renderSearchResults(query) {
      const list = document.getElementById('search-suggestions-list');
      const section = document.getElementById('search-suggestions');
      const results = products.filter(p =>
        p.name.toLowerCase().includes(query) ||
        p.category.toLowerCase().includes(query) ||
        p.description.toLowerCase().includes(query)
      );
      section.querySelector('h4').textContent = `Results for "${query}"`;
      if (results.length === 0) {
        list.innerHTML = '<p style="color:var(--warm-gray-dark);padding:16px 0;">No results found. Try a different search term.</p>';
        return;
      }
      list.innerHTML = results.map(p => `
    <div class="search-suggestion-item" onclick="closeSearch(); navigateTo('product', {id: ${p.id}})">
      <img src="${p.image}" alt="${p.name}" loading="lazy">
      <div class="info">
        <h5>${p.name}</h5>
        <span>${formatPrice(p.price)}</span>
      </div>
    </div>
  `).join('');
    }

    // ===== CART =====
    function saveCart() {
      localStorage.setItem('preshword_cart', JSON.stringify(cart));
      updateCartBadges();
    }

    function updateCartBadges() {
      const count = cart.reduce((sum, item) => sum + item.qty, 0);
      const headerBadge = document.getElementById('cart-count-header');
      const drawerCount = document.getElementById('cart-count-drawer');
      const bottomBadge = document.getElementById('cart-badge-bottom');

      headerBadge.textContent = count;
      drawerCount.textContent = count;
      bottomBadge.textContent = count;

      if (count > 0) {
        headerBadge.classList.add('visible');
        bottomBadge.classList.add('visible');
      } else {
        headerBadge.classList.remove('visible');
        bottomBadge.classList.remove('visible');
      }
    }

    function addToCart(productId, qty = 1) {
      const product = products.find(p => p.id === productId);
      if (!product) return;

      const existing = cart.find(item => item.id === productId);
      if (existing) {
        existing.qty += qty;
      } else {
        cart.push({ id: productId, qty });
      }

      saveCart();
      showToast(`${product.name} added to bag`);
    }

    function removeFromCart(productId) {
      cart = cart.filter(item => item.id !== productId);
      saveCart();
      renderCartDrawer();
      if (currentPage === 'cart') renderCartPage();
    }

    function updateCartQty(productId, delta) {
      const item = cart.find(i => i.id === productId);
      if (!item) return;
      item.qty = Math.max(1, item.qty + delta);
      saveCart();
      renderCartDrawer();
      if (currentPage === 'cart') renderCartPage();
    }

    function getCartTotal() {
      return cart.reduce((sum, item) => {
        const product = products.find(p => p.id === item.id);
        return sum + (product ? product.price * item.qty : 0);
      }, 0);
    }

    function openCart() {
      renderCartDrawer();
      document.getElementById('cart-overlay').classList.add('open');
      document.getElementById('cart-drawer').classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeCart() {
      document.getElementById('cart-overlay').classList.remove('open');
      document.getElementById('cart-drawer').classList.remove('open');
      document.body.style.overflow = '';
    }

    function renderCartDrawer() {
      const container = document.getElementById('cart-drawer-items');
      const footer = document.getElementById('cart-drawer-footer');

      if (cart.length === 0) {
        container.innerHTML = `
      <div class="cart-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <h4>Your bag is empty</h4>
        <p>Looks like you haven't added anything yet.</p>
        <a href="#" onclick="closeCart(); navigateTo('shop')">Start Shopping</a>
      </div>
    `;
        footer.style.display = 'none';
        return;
      }

      container.innerHTML = cart.map(item => {
        const p = products.find(pr => pr.id === item.id);
        if (!p) return '';
        return `
      <div class="cart-item">
        <div class="cart-item-image"><img src="${p.image}" alt="${p.name}" loading="lazy"></div>
        <div class="cart-item-info">
          <h4>${p.name}</h4>
          <div class="variant">${categories.find(c => c.id === p.category)?.name || ''}</div>
          <div class="cart-item-controls">
            <div class="cart-qty">
              <button onclick="updateCartQty(${p.id}, -1)" aria-label="Decrease quantity">−</button>
              <span>${item.qty}</span>
              <button onclick="updateCartQty(${p.id}, 1)" aria-label="Increase quantity">+</button>
            </div>
            <span class="cart-item-price">${formatPrice(p.price * item.qty)}</span>
          </div>
        </div>
        <button class="cart-item-remove" onclick="removeFromCart(${p.id})" aria-label="Remove item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
    `;
      }).join('');

      const total = getCartTotal();
      const delivery = total >= 15000 ? 0 : 1500;
      footer.style.display = '';
      footer.innerHTML = `
    <div class="cart-summary">
      <div class="cart-summary-row"><span>Subtotal</span><span>${formatPrice(total)}</span></div>
      <div class="cart-summary-row"><span>Delivery</span><span>${delivery === 0 ? 'Free' : formatPrice(delivery)}</span></div>
      <div class="cart-summary-row total"><span>Total</span><span class="amount">${formatPrice(total + delivery)}</span></div>
    </div>
    <button class="cart-checkout-btn" onclick="closeCart(); navigateTo('cart')">View Full Bag</button>
    <button class="cart-continue" onclick="closeCart()">Continue Shopping</button>
  `;
    }

    // ===== WISHLIST =====
    function toggleWishlist(productId) {
      const idx = wishlist.indexOf(productId);
      if (idx > -1) {
        wishlist.splice(idx, 1);
        showToast('Removed from wishlist');
      } else {
        wishlist.push(productId);
        showToast('Added to wishlist');
      }
      localStorage.setItem('preshword_wishlist', JSON.stringify(wishlist));
      updateWishlistButtons();
    }

    function updateWishlistButtons() {
      document.querySelectorAll('.product-wishlist-btn').forEach(btn => {
        const id = parseInt(btn.dataset.id);
        if (wishlist.includes(id)) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    // ===== RENDER CATEGORIES =====
    function renderCategories() {
      const grid = document.getElementById('categories-grid');
      grid.innerHTML = categories.map(cat => {
        const count = products.filter(p => p.category === cat.id).length;
        return `
    <div class="category-card fade-up" onclick="navigateTo('shop', {category: '${cat.id}'})" role="button" tabindex="0" aria-label="Browse ${cat.name}">
      <img src="${cat.image}" alt="${cat.name}" loading="lazy">
      <div class="category-card-overlay">
        <h3>${cat.name}</h3>
        <span>${count} product${count !== 1 ? 's' : ''}</span>
      </div>
    </div>
  `;
      }).join('');
    }

    // ===== RENDER PURPOSE GRID =====
    function renderPurposes() {
      const grid = document.getElementById('purpose-grid');
      grid.innerHTML = purposes.map(p => `
    <div class="purpose-card fade-up" onclick="navigateTo('shop')" role="button" tabindex="0" aria-label="${p.name}">
      <img src="${p.image}" alt="${p.name}" loading="lazy">
      <div class="purpose-card-overlay">
        <h3>${p.name}</h3>
      </div>
    </div>
  `).join('');
    }

    // ===== RENDER PRODUCTS =====
    function renderProductCard(p) {
      const isWished = wishlist.includes(p.id);
      const discount = p.originalPrice ? Math.round((1 - p.price / p.originalPrice) * 100) : 0;
      return `
    <div class="product-card fade-up" onclick="navigateTo('product', {id: ${p.id}})" role="button" tabindex="0">
      <div class="product-card-image">
        <img src="${p.image}" alt="${p.name}" loading="lazy">
        ${p.onSale ? `<span class="product-badge">−${discount}%</span>` : ''}
        ${p.isNew ? '<span class="product-badge" style="background:var(--forest)">New</span>' : ''}
        <button class="product-wishlist-btn ${isWished ? 'active' : ''}" data-id="${p.id}" onclick="event.stopPropagation(); toggleWishlist(${p.id})" aria-label="${isWished ? 'Remove from wishlist' : 'Add to wishlist'}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
      </div>
      <div class="product-card-body">
        <p class="product-category">${categories.find(c => c.id === p.category)?.name || ''}</p>
        <h3>${p.name}</h3>
        <div class="product-price">
          <span class="current">${formatPrice(p.price)}</span>
          ${p.originalPrice ? `<span class="original">${formatPrice(p.originalPrice)}</span>` : ''}
        </div>
      </div>
      <button class="quick-add-btn" onclick="event.stopPropagation(); addToCart(${p.id})" aria-label="Quick add ${p.name} to cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>
    </div>
  `;
    }

    function renderFeaturedProducts() {
      const grid = document.getElementById('featured-products');
      const featured = products.filter(p => p.isNew || p.onSale).slice(0, 8);
      grid.innerHTML = featured.map(renderProductCard).join('');
      updateWishlistButtons();
    }

    // ===== SHOP PAGE =====
    function renderShop(params = {}) {
      if (params.category !== undefined) {
        activeFilters.category = params.category === 'all' ? null : params.category;
      }
      let filtered = [...products];

      // Filter by category
      if (activeFilters.category) {
        filtered = filtered.filter(p => p.category === activeFilters.category);
      }

      // Filter by active filters
      if (activeFilters.priceMin) {
        filtered = filtered.filter(p => p.price >= activeFilters.priceMin);
      }
      if (activeFilters.priceMax) {
        filtered = filtered.filter(p => p.price <= activeFilters.priceMax);
      }
      if (activeFilters.inStock) {
        filtered = filtered.filter(p => p.inStock);
      }
      if (activeFilters.sale) {
        filtered = filtered.filter(p => p.onSale);
      }
      if (activeFilters.search) {
        const q = activeFilters.search.toLowerCase();
        filtered = filtered.filter(p =>
          p.name.toLowerCase().includes(q) ||
          p.category.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q)
        );
      }

      // Sort
      switch (currentSort) {
        case 'price-asc': filtered.sort((a, b) => a.price - b.price); break;
        case 'price-desc': filtered.sort((a, b) => b.price - a.price); break;
        case 'newest': filtered.sort((a, b) => (b.isNew ? 1 : 0) - (a.isNew ? 1 : 0)); break;
        default: break; // recommended = default order
      }

      // Update header
      const cat = categories.find(c => c.id === activeFilters.category);
      document.getElementById('shop-title').textContent = cat ? cat.name : 'Shop All Products';
      document.getElementById('shop-breadcrumb').textContent = cat ? cat.name : 'Shop All';
      document.getElementById('shop-description').textContent = cat
        ? `Browse our ${cat.name.toLowerCase()} collection.`
        : 'Discover our full collection of kitchenware, cookware, appliances, and dining essentials.';
      document.getElementById('result-count').textContent = `Showing ${filtered.length} product${filtered.length !== 1 ? 's' : ''}`;

      const grid = document.getElementById('shop-products');
      const empty = document.getElementById('shop-empty');

      if (filtered.length === 0) {
        grid.style.display = 'none';
        empty.style.display = '';
      } else {
        grid.style.display = '';
        empty.style.display = 'none';
        grid.innerHTML = filtered.map(renderProductCard).join('');
        updateWishlistButtons();
      }

      renderActiveFilters();
    }

    function renderActiveFilters() {
      const container = document.getElementById('active-filters');
      let chips = [];

      if (activeFilters.category && activeFilters.category !== 'all') {
        const cat = categories.find(c => c.id === activeFilters.category);
        if (cat) chips.push({ label: cat.name, key: 'category', value: null });
      }
      if (activeFilters.priceMin) chips.push({ label: `Min: ${formatPrice(activeFilters.priceMin)}`, key: 'priceMin', value: null });
      if (activeFilters.priceMax) chips.push({ label: `Max: ${formatPrice(activeFilters.priceMax)}`, key: 'priceMax', value: null });
      if (activeFilters.sale) chips.push({ label: 'On Sale', key: 'sale', value: false });

      container.innerHTML = chips.map(c => `
    <span class="filter-chip">${c.label} <button onclick="removeFilter('${c.key}', ${c.value})" aria-label="Remove filter">×</button></span>
  `).join('');
    }

    function removeFilter(key, value) {
      if (value === null) {
        activeFilters[key] = null;
      } else {
        activeFilters[key] = value;
      }
      if (key === 'category') {
        renderShop({ category: activeFilters.category || 'all' });
      } else {
        renderShop();
      }
    }

    function cycleSort() {
      const sorts = ['recommended', 'price-asc', 'price-desc', 'newest'];
      const labels = ['Recommended', 'Price: Low → High', 'Price: High → Low', 'Newest'];
      const idx = (sorts.indexOf(currentSort) + 1) % sorts.length;
      currentSort = sorts[idx];
      document.getElementById('sort-label').textContent = labels[idx];
      renderShop();
    }

    // ===== FILTERS =====
    function openFilters() {
      document.getElementById('filter-overlay').classList.add('open');
      document.getElementById('filter-drawer').classList.add('open');
      document.body.style.overflow = 'hidden';
      renderFilterCategories();
    }

    function closeFilters() {
      document.getElementById('filter-overlay').classList.remove('open');
      document.getElementById('filter-drawer').classList.remove('open');
      document.body.style.overflow = '';
    }

    function renderFilterCategories() {
      const container = document.getElementById('filter-categories');
      container.innerHTML = categories.map(cat => `
    <div class="filter-option">
      <input type="checkbox" id="fc-${cat.id}" value="${cat.id}" ${activeFilters.category === cat.id ? 'checked' : ''}>
      <label for="fc-${cat.id}">${cat.name}</label>
    </div>
  `).join('');
    }

    function applyFilters() {
      const checked = document.querySelector('#filter-categories input:checked');
      activeFilters.category = checked ? checked.value : null;
      activeFilters.priceMin = parseInt(document.getElementById('filter-price-min').value) || null;
      activeFilters.priceMax = parseInt(document.getElementById('filter-price-max').value) || null;
      activeFilters.inStock = document.getElementById('filter-instock').checked;
      activeFilters.sale = document.getElementById('filter-sale').checked;
      closeFilters();
      renderShop();
    }

    function resetFilters() {
      activeFilters = { category: null, priceMin: null, priceMax: null, inStock: true, sale: false };
      document.getElementById('filter-price-min').value = '';
      document.getElementById('filter-price-max').value = '';
      document.getElementById('filter-instock').checked = true;
      document.getElementById('filter-sale').checked = false;
      closeFilters();
      renderShop();
    }

    // ===== PRODUCT DETAIL =====
    function renderProductDetail(id) {
      const p = products.find(pr => pr.id === id);
      if (!p) return;

      const cat = categories.find(c => c.id === p.category);
      const discount = p.originalPrice ? Math.round((1 - p.price / p.originalPrice) * 100) : 0;
      const isWished = wishlist.includes(p.id);
      const gallery = (p.gallery && p.gallery.length) ? p.gallery : [p.image];

      const container = document.getElementById('product-detail');
      container.innerHTML = `
    <div class="pd-header">
      <div class="breadcrumb">
        <a href="#" onclick="navigateTo('home')">Home</a>
        <span>/</span>
        <a href="#" onclick="navigateTo('shop', {category: '${p.category}'})">${cat?.name || 'Shop'}</a>
        <span>/</span>
        <span>${p.name}</span>
      </div>
    </div>
    <div class="pd-gallery">
      <img src="${gallery[0]}" alt="${p.name}" id="pd-main-image">
    </div>
    ${gallery.length > 1 ? `
    <div class="pd-gallery-thumbnails">
      ${gallery.map((img, idx) => `
        <button class="${idx === 0 ? 'active' : ''}" onclick="document.getElementById('pd-main-image').src='${img}'; this.parentElement.querySelectorAll('button').forEach(b=>b.classList.remove('active')); this.classList.add('active');">
          <img src="${img}" alt="${p.name} view ${idx + 1}">
        </button>
      `).join('')}
    </div>
    ` : ''}
    <div class="pd-info">
      <p class="product-category">${cat?.name || ''}</p>
      <h1>${p.name}</h1>
      <div class="pd-price">
        <span class="current">${formatPrice(p.price)}</span>
        ${p.originalPrice ? `<span class="original">${formatPrice(p.originalPrice)}</span><span class="discount">−${discount}%</span>` : ''}
      </div>
      <div class="pd-availability">
        <span class="dot"></span>
        ${p.inStock ? 'In Stock — Ready to Ship' : 'Out of Stock'}
      </div>
      <div class="pd-quantity">
        <span style="font-size:0.85rem;font-weight:500;">Quantity:</span>
        <div class="quantity-control">
          <button onclick="updatePdQty(-1)" aria-label="Decrease">−</button>
          <input type="number" id="pd-qty" value="1" min="1" max="99" readonly>
          <button onclick="updatePdQty(1)" aria-label="Increase">+</button>
        </div>
      </div>
      <div class="pd-actions">
        <button class="pd-add-btn" onclick="addToCart(${p.id}, parseInt(document.getElementById('pd-qty').value))">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          Add to Bag — ${formatPrice(p.price)}
        </button>
        <button class="pd-wishlist-btn ${isWished ? 'active' : ''}" onclick="toggleWishlist(${p.id}); this.classList.toggle('active');" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
      </div>
      
      <div class="accordion">
        <div class="accordion-item open">
          <button class="accordion-trigger" onclick="toggleAccordion(this)">
            Description
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="accordion-content">
            <div class="accordion-body">${p.description}</div>
          </div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger" onclick="toggleAccordion(this)">
            Specifications
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="accordion-content">
            <div class="accordion-body">
              <ul>
                ${Object.entries(p.specs).map(([k, v]) => `<li><strong>${k.charAt(0).toUpperCase() + k.slice(1)}:</strong> ${v}</li>`).join('')}
              </ul>
            </div>
          </div>
        </div>
        <div class="accordion-item">
          <button class="accordion-trigger" onclick="toggleAccordion(this)">
            Delivery & Returns
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="accordion-content">
            <div class="accordion-body">
              <p>Free delivery on orders over ₦15,000. Lagos next-day delivery, nationwide 2-5 business days.</p>
              <p style="margin-top:8px;">30-day return policy. Items must be unused and in original packaging.</p>
            </div>
          </div>
        </div>
      </div>
      
      <h3 style="font-family:var(--font-serif);font-size:1.1rem;margin-bottom:16px;">You May Also Like</h3>
      <div class="products-grid" style="grid-template-columns: repeat(2, 1fr);">
        ${products.filter(pr => pr.category === p.category && pr.id !== p.id).slice(0, 4).map(renderProductCard).join('')}
      </div>
    </div>
    
    <!-- Sticky mobile buy bar -->
    <div class="sticky-buy-bar" id="sticky-buy-bar" style="display:flex;">
      <span class="sticky-price">${formatPrice(p.price)}</span>
      <button class="sticky-btn" onclick="addToCart(${p.id}, parseInt(document.getElementById('pd-qty').value))">Add to Bag</button>
    </div>
  `;
      updateWishlistButtons();
    }

    function updatePdQty(delta) {
      const input = document.getElementById('pd-qty');
      let val = parseInt(input.value) + delta;
      if (val < 1) val = 1;
      if (val > 99) val = 99;
      input.value = val;
    }

    function toggleAccordion(trigger) {
      const item = trigger.parentElement;
      item.classList.toggle('open');
    }

    // ===== CART PAGE =====
    function renderCartPage() {
      const container = document.getElementById('cart-page-content');

      if (cart.length === 0) {
        container.innerHTML = `
      <div class="wishlist-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <h3>Your bag is empty</h3>
        <p>Start adding items to your bag and they'll appear here.</p>
        <button class="btn-primary" style="background:var(--forest);box-shadow:none;" onclick="navigateTo('shop')">Browse Products</button>
      </div>
    `;
        return;
      }

      const total = getCartTotal();
      const delivery = total >= 15000 ? 0 : 1500;

      container.innerHTML = `
    <div class="breadcrumb">
      <a href="#" onclick="navigateTo('home')">Home</a>
      <span>/</span>
      <span>Your Bag</span>
    </div>
    <h1>Your Bag (${cart.reduce((s, i) => s + i.qty, 0)} items)</h1>
    <div class="cart-page-items">
      ${cart.map(item => {
        const p = products.find(pr => pr.id === item.id);
        if (!p) return '';
        const cat = categories.find(c => c.id === p.category);
        return `
          <div class="cart-page-item">
            <div class="cart-page-item-image"><img src="${p.image}" alt="${p.name}" loading="lazy"></div>
            <div class="cart-page-item-info">
              <h3>${p.name}</h3>
              <p class="variant">${cat?.name || ''}</p>
              <div style="display:flex;align-items:center;gap:12px;margin-top:8px;">
                <div class="cart-qty">
                  <button onclick="updateCartQty(${p.id}, -1)" aria-label="Decrease">−</button>
                  <span>${item.qty}</span>
                  <button onclick="updateCartQty(${p.id}, 1)" aria-label="Increase">+</button>
                </div>
                <span class="price">${formatPrice(p.price * item.qty)}</span>
              </div>
            </div>
            <button class="cart-item-remove" onclick="removeFromCart(${p.id})" aria-label="Remove">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        `;
      }).join('')}
    </div>
    <div class="cart-page-summary">
      <h3>Order Summary</h3>
      <div class="cart-summary-row"><span>Subtotal</span><span>${formatPrice(total)}</span></div>
      <div class="cart-summary-row"><span>Delivery</span><span>${delivery === 0 ? 'Free' : formatPrice(delivery)}</span></div>
      <div class="cart-summary-row total"><span>Total</span><span>${formatPrice(total + delivery)}</span></div>
      <button class="cart-checkout-btn" onclick="navigateTo('checkout')" style="margin-top:16px;">Proceed to Checkout</button>
      <button class="cart-continue" onclick="navigateTo('shop')">Continue Shopping</button>
    </div>
  `;
    }

    // ===== WISHLIST PAGE =====
    function renderWishlistPage() {
      const container = document.getElementById('wishlist-page-content');

      if (wishlist.length === 0) {
        container.innerHTML = `
      <div class="breadcrumb">
        <a href="#" onclick="navigateTo('home')">Home</a>
        <span>/</span>
        <span>Wishlist</span>
      </div>
      <h1>Your Wishlist</h1>
      <div class="wishlist-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <h3>No saved items yet</h3>
        <p>Tap the heart icon on any product to save it for later.</p>
        <button class="btn-primary" style="background:var(--forest);box-shadow:none;" onclick="navigateTo('shop')">Start Browsing</button>
      </div>
    `;
        return;
      }

      const wishedProducts = products.filter(p => wishlist.includes(p.id));
      container.innerHTML = `
    <div class="breadcrumb">
      <a href="#" onclick="navigateTo('home')">Home</a>
      <span>/</span>
      <span>Wishlist</span>
    </div>
    <h1>Your Wishlist (${wishedProducts.length} items)</h1>
    <div class="products-grid" style="grid-template-columns: repeat(2, 1fr); gap: 16px;">
      ${wishedProducts.map(renderProductCard).join('')}
    </div>
  `;
      updateWishlistButtons();
    }

    // ===== CHECKOUT PAGE (PROTOTYPE) =====
    function renderCheckoutPage() {
      const container = document.getElementById('checkout-page-content');
      const total = getCartTotal();
      const delivery = total >= 15000 ? 0 : 1500;

      if (cart.length === 0) {
        container.innerHTML = `
      <div class="wishlist-empty">
        <h3>Nothing to checkout</h3>
        <p>Add items to your bag first.</p>
        <button class="btn-primary" style="background:var(--forest);box-shadow:none;" onclick="navigateTo('shop')">Browse Products</button>
      </div>
    `;
        return;
      }

      container.innerHTML = `
    <div class="breadcrumb">
      <a href="#" onclick="navigateTo('home')">Home</a>
      <span>/</span>
      <a href="#" onclick="navigateTo('cart')">Bag</a>
      <span>/</span>
      <span>Checkout</span>
    </div>
    <h1>Checkout</h1>
    <p class="subtitle" style="color:var(--warm-gray-dark);font-size:0.9rem;">This is a prototype. No real payments will be processed.</p>
    
    <div class="checkout-steps">
      <div class="checkout-step active"><span class="step-num">1</span> Contact</div>
      <div class="checkout-step"><span class="step-num">2</span> Delivery</div>
      <div class="checkout-step"><span class="step-num">3</span> Review</div>
    </div>
    
    <div class="cart-page-summary" style="margin-bottom:24px;">
      <h3>Order Summary</h3>
      ${cart.map(item => {
        const p = products.find(pr => pr.id === item.id);
        if (!p) return '';
        return `<div class="cart-summary-row"><span>${p.name} × ${item.qty}</span><span>${formatPrice(p.price * item.qty)}</span></div>`;
      }).join('')}
      <div class="cart-summary-row"><span>Delivery</span><span>${delivery === 0 ? 'Free' : formatPrice(delivery)}</span></div>
      <div class="cart-summary-row total"><span>Total</span><span>${formatPrice(total + delivery)}</span></div>
    </div>
    
    <form class="checkout-form" onsubmit="handleCheckout(event)">
      <div class="form-group">
        <label for="co-name">Full Name</label>
        <input type="text" id="co-name" required placeholder="Adebayo Johnson">
        <span class="error">Please enter your full name</span>
      </div>
      <div class="form-group">
        <label for="co-email">Email Address</label>
        <input type="email" id="co-email" required placeholder="adebayo@example.com">
        <span class="error">Please enter a valid email</span>
      </div>
      <div class="form-group">
        <label for="co-phone">Phone Number</label>
        <input type="tel" id="co-phone" required placeholder="0801 234 5678" pattern="[0-9\\s\\+]{10,15}">
        <span class="error">Please enter a valid phone number</span>
      </div>
      <div class="form-group">
        <label for="co-address">Delivery Address</label>
        <input type="text" id="co-address" required placeholder="12 Admiralty Way, Lekki Phase 1, Lagos">
        <span class="error">Please enter your delivery address</span>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="co-city">City</label>
          <input type="text" id="co-city" required placeholder="Lagos">
          <span class="error">Required</span>
        </div>
        <div class="form-group">
          <label for="co-state">State</label>
          <select id="co-state" required>
            <option value="">Select state</option>
            <option>Lagos</option>
            <option>Abuja</option>
            <option>Rivers</option>
            <option>Oyo</option>
            <option>Kaduna</option>
            <option>Enugu</option>
            <option>Kano</option>
            <option>Ogun</option>
          </select>
          <span class="error">Please select a state</span>
        </div>
      </div>
      <div class="form-group">
        <label>Payment Method</label>
        <div style="display:flex;flex-direction:column;gap:8px;">
          <label style="display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--warm-gray);border-radius:var(--radius-sm);cursor:pointer;">
            <input type="radio" name="payment" value="transfer" checked> Bank Transfer
          </label>
          <label style="display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--warm-gray);border-radius:var(--radius-sm);cursor:pointer;">
            <input type="radio" name="payment" value="card"> Card Payment (Prototype)
          </label>
          <label style="display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--warm-gray);border-radius:var(--radius-sm);cursor:pointer;">
            <input type="radio" name="payment" value="cod"> Pay on Delivery
          </label>
        </div>
      </div>
      <button type="submit" class="checkout-btn">Place Order — ${formatPrice(total + delivery)}</button>
      <p style="font-size:0.8rem;color:var(--warm-gray-dark);text-align:center;margin-top:8px;">This is a frontend prototype. No actual order will be placed.</p>
    </form>
  `;
    }

    function handleCheckout(e) {
      e.preventDefault();
      showToast('Order placed successfully! (Prototype)');
      cart = [];
      saveCart();
      setTimeout(() => navigateTo('home'), 1500);
    }

    // ===== NEWSLETTER =====
    function handleNewsletter(e) {
      e.preventDefault();
      const input = e.target.querySelector('input');
      const email = input.value.trim();
      const successEl = document.getElementById('newsletter-success');
      const errorEl = document.getElementById('newsletter-error');

      successEl.style.display = 'none';
      errorEl.style.display = 'none';

      if (!email || !email.includes('@') || !email.includes('.')) {
        errorEl.style.display = 'block';
        return;
      }

      successEl.style.display = 'block';
      input.value = '';
    }

    // ===== SCROLL ANIMATIONS =====
    function initScrollAnimations() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    }

    // ===== INIT =====
    function init() {
      renderCategories();
      renderFeaturedProducts();
      renderPurposes();
      updateCartBadges();
      updateWishlistButtons();

      // Re-observe after render
      setTimeout(initScrollAnimations, 100);

      // Mutation observer for dynamically added fade-up elements
      const mutObserver = new MutationObserver(() => {
        document.querySelectorAll('.fade-up:not(.visible)').forEach(el => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            el.classList.add('visible');
          }
        });
      });
      mutObserver.observe(document.body, { childList: true, subtree: true });
    }

    document.addEventListener('DOMContentLoaded', init);
  </script>
</body>

</html>